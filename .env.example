# Development: bun run db:dev starts a persistent loopback MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27019/ceylon
MONGODB_DB=ceylon
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep true for local sample listings; false on a real public deployment.
DEMO_CONTENT=true
# Google Identity Services: authorized JavaScript origin must match site URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required for production registration and guest contact verification.
RESEND_API_KEY=
EMAIL_FROM=
# Only true behind an ingress that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Google AdSense Auto ads: disabled until account approval and privacy setup.
ADSENSE_PUBLISHER_ID=
ADSENSE_ENABLED=false
# Set true only after publishing Google Privacy & Messaging and page exclusions.
ADSENSE_PRIVACY_READY=false
